# Copy to backend/.env and fill in your Cloudinary credentials.
# The API secret must stay on the server. Never put it in a VITE_ variable.

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional. Defaults to a SQLite file at backend/data/wardrobe.db
# DATABASE_URL=sqlite:///./data/wardrobe.db

# Comma-separated origins allowed to call the API from a browser.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication cookies. Keep false for local HTTP; set true behind HTTPS in production.
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=lax
# SESSION_TTL_HOURS=168
