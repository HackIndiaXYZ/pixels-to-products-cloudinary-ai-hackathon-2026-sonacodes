# Optional. The app also reads the cloud name from GET /api/health
# after the backend is configured. Never put the Cloudinary API secret here.
VITE_CLOUDINARY_CLOUD_NAME=

# Leave empty in local development so Vite proxies /api to http://127.0.0.1:8000.
# Set this if the API is hosted on another origin.
VITE_API_BASE_URL=
